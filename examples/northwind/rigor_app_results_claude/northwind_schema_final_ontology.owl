  <rdf:Description rdf:about="http://example.org/ontology#hasDirectReport">
    <rdfs:label xml:lang="en">has direct report</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="http://example.org/ontology/provenance/employees/reportsTo"/>
    <rdfs:seeAlso rdf:resource="http://example.org/ontology#employees_reportsTo"/>
    <rdfs:range rdf:resource="http://example.org/ontology#Employee"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment xml:lang="en">Inverse of employees_reportsTo. Links a supervisor to the employees who report directly to them. This is an explicitly recursive self-referential relationship justified by the employees.reportsTo foreign key that references employees.employeeID, forming a management hierarchy tree within the same class.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology#Employee"/>
  </rdf:Description>
