  <rdf:Description rdf:about="http://example.org/ontology#employees_reportsTo">
    <skos:altLabel xml:lang="en">reports to</skos:altLabel>
    <rdfs:comment xml:lang="en">Relates an employee to their supervisor.</rdfs:comment>
    <rdfs:comment xml:lang="en">Relates an employee to another employee who is their supervisor.</rdfs:comment>
    <rdfs:comment xml:lang="en">Object property generated from foreign key 'employees.reportsTo' referencing 'employees.employeeID'. This is an explicit recursive self-referential relationship within the Employees class.</rdfs:comment>
    <rdfs:comment xml:lang="en">The supervisor of this employee. This is an explicitly recursive self-referential relationship within the Employees class, modelling the management hierarchy: each employee may report to at most one other employee. May be absent for employees at the top of the hierarchy (e.g. the CEO). Justified self-reference: the employees table has a foreign key reportsTo referencing its own primary key employeeID, defining a tree-structured reporting chain.</rdfs:comment>
    <rdfs:label xml:lang="en">employees reports To</rdfs:label>
    <rdfs:label xml:lang="en">reports to</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="http://example.org/ontology/provenance/employees/reportsTo"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
