  <rdf:Description rdf:about="http://example.org/ontology#suppliers_postalCode">
    <skos:altLabel xml:lang="en">postal code</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/ontology/provenance/suppliers/postalCode"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Suppliers"/>
    <rdfs:label xml:lang="en">postal Code</rdfs:label>
    <rdfs:comment xml:lang="en">Postal or ZIP code of the supplier. May be empty.</rdfs:comment>
    <rdfs:comment xml:lang="en">Data property generated from source column 'suppliers.postalCode' with range xsd:string.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#suppliers_supplierID">
    <rdfs:domain rdf:resource="http://example.org/ontology#Suppliers"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/ontology/provenance/suppliers/supplierID"/>
    <rdfs:comment xml:lang="en">Data property generated from source column 'suppliers.supplierID' with range xsd:integer.</rdfs:comment>
    <rdfs:comment xml:lang="en">Unique identifier of the supplier. Primary key of the suppliers table.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">supplier ID</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </rdf:Description>
