  <rdf:Description rdf:about="http://example.org/ontology#order_details_hasOrder">
    <skos:altLabel xml:lang="en">order details has Order</skos:altLabel>
    <prov:wasDerivedFrom rdf:resource="http://example.org/ontology/provenance/order_details/orderID"/>
    <rdfs:comment xml:lang="en">Object property generated from foreign key 'order_details.orderID' referencing 'orders.orderID'.</rdfs:comment>
    <rdfs:comment xml:lang="en">Links an order detail line item to the order it belongs to. Derived from the foreign key order_details.orderID → orders.orderID. Every line item belongs to exactly one order, and an order may have many line items.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology#OrderDetails"/>
    <rdfs:label xml:lang="en">belongs to order</rdfs:label>
    <rdfs:range rdf:resource="http://example.org/ontology#Orders"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#products_unitsOnOrder">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <skos:altLabel xml:lang="en">units on order</skos:altLabel>
    <rdfs:label xml:lang="en">units On Order</rdfs:label>
    <rdfs:comment xml:lang="en">Data property generated from source column 'products.unitsOnOrder' with range xsd:integer.</rdfs:comment>
    <rdfs:comment xml:lang="en">The number of units that have been ordered from the supplier but not yet received into inventory. A non-negative integer.</rdfs:comment>
    <prov:wasDerivedFrom rdf:resource="http://example.org/ontology/provenance/products/unitsOnOrder"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Products"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#products_unitPrice">
    <prov:wasDerivedFrom rdf:resource="http://example.org/ontology/provenance/products/unitPrice"/>
    <rdfs:label xml:lang="en">unit Price</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <skos:altLabel xml:lang="en">unit price</skos:altLabel>
    <rdfs:comment xml:lang="en">The current catalogue selling price for one unit of the product, in the company's base currency. This is the list price; actual order-line prices may differ due to discounts or price changes.</rdfs:comment>
    <rdfs:comment xml:lang="en">Data property generated from source column 'products.unitPrice' with range xsd:decimal.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology#Products"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#orders_hasShippers">
    <rdfs:label xml:lang="en">orders has Shippers</rdfs:label>
    <rdfs:comment xml:lang="en">The shipping company (carrier) used to deliver this order. Foreign key from orders.shipVia to shippers.shipperID.</rdfs:comment>
    <rdfs:comment xml:lang="en">Object property generated from foreign key 'orders.shipVia' referencing 'shippers.shipperID'.</rdfs:comment>
    <prov:wasDerivedFrom rdf:resource="http://example.org/ontology/provenance/orders/shipVia"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Orders"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:range rdf:resource="http://example.org/ontology#Shippers"/>
    <skos:altLabel xml:lang="en">shipped via</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n21f7148965814c51b480dba2ef848eb8b107">
    <owl:onProperty rdf:resource="http://example.org/ontology#suppliers_supplierID"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
