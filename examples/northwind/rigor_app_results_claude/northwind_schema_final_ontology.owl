    <rdfs:comment xml:lang="en">Class generated from source table 'orders'.</rdfs:comment>
    <rdfs:comment xml:lang="en">The header record for a customer order: who placed it, which employee handled it, when it was placed and shipped, how it was shipped, and where it was sent. Individual line items are held in OrderDetails.</rdfs:comment>
    <rdfs:comment xml:lang="en">A customer order.</rdfs:comment>
    <owl:disjointWith rdf:resource="http://example.org/ontology#Customers"/>
    <owl:disjointWith rdf:resource="http://example.org/ontology#Shippers"/>
    <owl:disjointWith rdf:resource="http://example.org/ontology#Employees"/>
    <owl:hasKey rdf:nodeID="n21f7148965814c51b480dba2ef848eb8b177"/>
    <skos:altLabel xml:lang="en">Orders</skos:altLabel>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Order</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="http://example.org/ontology/provenance/orders"/>
  </rdf:Description>
