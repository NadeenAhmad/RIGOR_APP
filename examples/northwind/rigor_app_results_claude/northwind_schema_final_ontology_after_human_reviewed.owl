  <rdf:Description rdf:about="http://example.org/ontology#order_details_hasProduct">
    <skos:altLabel xml:lang="en">refers to product</skos:altLabel>
    <rdfs:domain rdf:resource="http://example.org/ontology#OrderDetails"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment xml:lang="en">Object property generated from foreign key 'order_details.productID' referencing 'products.productID'.</rdfs:comment>
    <rdfs:comment xml:lang="en">Links an order detail line item to the product being sold on that line. Derived from the foreign key order_details.productID → products.productID. Each line item refers to exactly one product; a product may appear on many line items across different orders.</rdfs:comment>
    <rdfs:label xml:lang="en">order details has Product</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="http://example.org/ontology/provenance/order_details/productID"/>
    <rdfs:range rdf:resource="http://example.org/ontology#Products"/>
  </rdf:Description>
