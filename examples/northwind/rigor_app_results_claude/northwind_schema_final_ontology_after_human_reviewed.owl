    <rdfs:label xml:lang="en">reports to</rdfs:label>
    <skos:altLabel xml:lang="en">reports to</skos:altLabel>
    <prov:wasDerivedFrom rdf:resource="http://example.org/ontology/provenance/employees/reportsTo"/>
  </rdf:Description>
