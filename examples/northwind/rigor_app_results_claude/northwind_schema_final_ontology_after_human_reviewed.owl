  <rdf:Description rdf:about="http://example.org/ontology#employees_region">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment xml:lang="en">Data property generated from source column 'employees.region' with range xsd:string.</rdfs:comment>
    <rdfs:comment xml:lang="en">Home state, province, or region of the employee. May be empty for employees outside regions that use this field.</rdfs:comment>
    <prov:wasDerivedFrom rdf:resource="http://example.org/ontology/provenance/employees/region"/>
    <rdfs:label xml:lang="en">home region</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/ontology#Employees"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <skos:altLabel xml:lang="en">region</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N44c508c57a474230afe6108b0968e792">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
