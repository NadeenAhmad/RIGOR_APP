    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#resp_asmt_hasDX">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">has cancer diagnosis</rdfs:label>
    <skos:altLabel xml:lang="en">resp asmt has DX</skos:altLabel>
    <rdfs:comment xml:lang="en">Object property generated from foreign key 'resp_asmt.DX_ID' referencing 'tumor_dx.DX_ID'.</rdfs:comment>
    <rdfs:comment xml:lang="en">Foreign-key relationship linking the tumour response assessment to the assessed cancer diagnosis.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology#RespAsmt"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/ontology/provenance/resp_asmt/DX_ID"/>
    <rdfs:range rdf:resource="http://example.org/ontology#TumorDx"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n71adf11004174a459975bf6d6aa618e5b47">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
