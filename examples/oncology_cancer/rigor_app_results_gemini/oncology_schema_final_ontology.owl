    <rdfs:comment xml:lang="en">Class generated from source table 'ae_tox'.</rdfs:comment>
    <rdfs:comment xml:lang="en">An adverse event or treatment-related toxicity observed in a patient during a chemotherapy treatment cycle, graded according to CTCAE criteria.</rdfs:comment>
    <prov:wasDerivedFrom rdf:resource="http://example.org/ontology/provenance/ae_tox"/>
    <owl:hasKey rdf:nodeID="n71adf11004174a459975bf6d6aa618e5b75"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:altLabel xml:lang="en">Ae Tox</skos:altLabel>
    <rdfs:label xml:lang="en">Adverse Event and Toxicity Record</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#ae_tox_SAE_FLG">
    <skos:altLabel xml:lang="en">SAE FLG</skos:altLabel>
    <rdfs:domain rdf:resource="http://example.org/ontology#AeTox"/>
    <rdfs:comment xml:lang="en">Data property generated from source column 'ae_tox.SAE_FLG' with range xsd:boolean.</rdfs:comment>
    <rdfs:comment xml:lang="en">Boolean flag indicating whether the event meets regulatory criteria for a Serious Adverse Event (SAE), such as requiring hospitalization or being life-threatening.</rdfs:comment>
    <rdfs:label xml:lang="en">serious adverse event flag</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="http://example.org/ontology/provenance/ae_tox/SAE_FLG"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#TxCyc">
    <rdfs:comment xml:lang="en">Class representing a chemotherapy administration cycle.</rdfs:comment>
    <rdfs:comment xml:lang="en">An administered chemotherapy treatment cycle for a cancer diagnosis, capturing cycle number, administered regimen, administration date, dose percentage, and delay status.</rdfs:comment>
    <rdfs:comment xml:lang="en">Class generated from source table 'tx_cyc'.</rdfs:comment>
