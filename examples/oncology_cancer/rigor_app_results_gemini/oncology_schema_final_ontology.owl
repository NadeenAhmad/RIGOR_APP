  <rdf:Description rdf:about="http://example.org/ontology#pt_mstr_SMK_ST">
    <rdfs:comment xml:lang="en">Categorical smoking status: 'N' = never smoker, 'F' = former smoker, 'C' = current smoker.</rdfs:comment>
