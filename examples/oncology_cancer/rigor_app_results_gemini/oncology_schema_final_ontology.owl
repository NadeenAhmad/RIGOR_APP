  <rdf:Description rdf:about="http://example.org/ontology#tx_cyc_PRESCR_ID">
    <rdfs:comment xml:lang="en">Identifier of the prescribing oncologist for this treatment cycle; references onc_staff.STAFF_ID.</rdfs:comment>
    <rdfs:comment xml:lang="en">Data property generated from source column 'tx_cyc.PRESCR_ID' with range xsd:integer.</rdfs:comment>
    <skos:altLabel xml:lang="en">PRESCR ID</skos:altLabel>
    <skos:altLabel xml:lang="en">tx cyc PRESCR ID</skos:altLabel>
    <prov:wasDerivedFrom rdf:resource="http://example.org/ontology/provenance/tx_cyc/PRESCR_ID"/>
