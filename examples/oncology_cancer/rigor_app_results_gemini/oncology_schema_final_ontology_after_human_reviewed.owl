  <rdf:Description rdf:about="http://example.org/ontology#resp_asmt_RECIST_CD">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <skos:altLabel xml:lang="en">RECIST CD</skos:altLabel>
    <rdfs:comment xml:lang="en">Data property generated from source column 'resp_asmt.RECIST_CD' with range xsd:string.</rdfs:comment>
    <rdfs:comment xml:lang="en">Tumour response classification according to RECIST 1.1: CR (Complete Response), PR (Partial Response), SD (Stable Disease), PD (Progressive Disease), NE (Not Evaluable).</rdfs:comment>
    <prov:wasDerivedFrom rdf:resource="http://example.org/ontology/provenance/resp_asmt/RECIST_CD"/>
    <rdfs:label xml:lang="en">RECIST response code</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#RespAsmt"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#tx_cyc_DOSE_PCT">
    <skos:altLabel xml:lang="en">DOSE PCT</skos:altLabel>
    <skos:altLabel xml:lang="en">tx cyc DOSE PCT</skos:altLabel>
    <rdfs:comment xml:lang="en">Data property generated from source column 'tx_cyc.DOSE_PCT' with range xsd:decimal.</rdfs:comment>
    <rdfs:comment xml:lang="en">Percentage of the planned protocol dose actually administered (100 indicates full dose; lower values reflect dose reductions).</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology#TxCyc"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/ontology/provenance/tx_cyc/DOSE_PCT"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">dose percentage</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </rdf:Description>
